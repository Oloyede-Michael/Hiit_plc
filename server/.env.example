# API server
PORT=4001

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=hiitplc
PGUSER=postgres
PGPASSWORD=postgres
# Optional: set DATABASE_URL instead of the PG* variables above
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/hiitplc

# Auth: use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string

# Seeded officer account (used by `npm run db:seed`)
ADMIN_EMAIL=admin.officer@hiitplc.com
ADMIN_PASSWORD=ChangeMe123!

# Only needed if the client is served from a different origin in production
CLIENT_ORIGIN=http://localhost:5173
